# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). Local values print from `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS: used by webhooks and playback checks. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Mux (Settings → Access Tokens, Signing Keys, Webhooks)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# Public URL of this site, used for auth redirects and upload CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
